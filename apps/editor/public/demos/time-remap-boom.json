              {
                "kind": "shape",
                "id": "gravity-circle",
                "name": "Circle",
                "shape": "ellipse",
                "params": {
                  "width": 420,
                  "height": 420,
                  "fill": true,
                  "fillColor": "#D2502F",
                  "stroke": false
                },
                "transform": {
                  "x": 0,
                  "y": 0
                },
                "stack": [
                  {
                    "id": "gravity-circle-damage",
                    "type": "damage",
                    "params": {
                      "seed": 12,
                      "growth": {
                        "$expr": "clamp((scene.time - 0.4) / 0.7, 0, 1)",
                        "fallback": 0
                      },
                      "through": 5,
