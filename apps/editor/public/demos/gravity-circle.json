                "type": "opacity",
                "params": {
                  "opacity": 0
                }
              }
            ]
          }
        ]
      }
    ],
    "animation": {
      "duration": 8,
      "fps": 30,
      "loop": true,
      "autoplay": true,
      "tracks": [
