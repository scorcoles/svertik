          "param": "scale",
          "keys": [
            {
              "t": 0,
              "value": 1,
              "ease": "linear"
            },
            {
              "t": 0.78,
              "value": 1,
              "ease": "ease-in"
            },
            {
              "t": 1.04,
              "value": 0.94,
              "ease": "ease-out"
            },
            {
              "t": 1.17,
              "value": 1.06,
              "ease": "ease-in-out"
            },
            {
              "t": 1.42,
              "value": 1
            }
          ]
        }
      ]
    }
  }
}
