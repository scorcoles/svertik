{
  "svertik": "project",
  "version": 1,
  "name": "Rhythm",
  "scene": {
    "version": 1,
    "background": "#f2e8da",
    "document": {
      "width": 1000,
      "height": 500
    },
    "notes": "Five crosses breathe in rhythm with Pulse (scale and hue). At 2 seconds, Shake sends an impact through them with 0.15 seconds between elements. Pulse uses cycle fractions for attack and decay; Shake uses seconds for start, duration and delay. Both follow scene.time and need no keyframes.",
    "animation": {
      "duration": 6,
      "loop": true,
      "autoplay": true,
      "fps": 30,
      "tracks": []
    },
    "objects": [
      {
        "kind": "shape",
        "id": "rhythm-cross",
        "name": "Cross",
        "shape": "cross",
        "params": {
          "size": 70,
          "width": 16,
          "fill": true,
          "fillColor": "#D2502F",
          "stroke": false
        },
        "stack": [
          {
            "id": "rhythm-grid",
            "type": "clone",
            "params": {
              "mode": "grid",
              "columns": 5,
              "rows": 1,
              "spacing": [
                2.3,
                1
              ]
            }
          },
          {
            "id": "rhythm-pulse",
            "type": "pulse",
            "params": {
              "time": {
                "$expr": "scene.time",
                "fallback": 0
              },
              "frequency": 1,
              "attack": 0.08,
              "decay": 0.55,
              "elementPhase": 36
            },
            "children": [
              {
                "id": "rhythm-scale",
                "type": "transform",
                "params": {
                  "scale": 1.35
                }
              },
              {
                "id": "rhythm-color",
                "type": "color",
                "params": {
                  "mode": "shift",
                  "hue": 20
                }
              }
            ]
          },
          {
            "id": "rhythm-shake",
            "type": "shake",
            "params": {
              "time": {
                "$expr": "scene.time",
                "fallback": 0
              },
              "start": 2,
              "duration": 1.2,
              "frequency": 10,
              "perElement": true,
              "elementDelay": 0.15,
              "seed": 3
            },
            "children": [
              {
                "id": "rhythm-impact",
                "type": "transform",
                "params": {
                  "x": 18,
                  "y": 10,
                  "rotation": 25
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
