{
  "svertik": "project",
  "version": 1,
  "name": "Motion",
  "scene": {
    "version": 1,
    "background": "#f2e8da",
    "document": {
      "width": 1000,
      "height": 700
    },
    "notes": "A grid of crosses animated without keyframes. Wiggle adds independent smooth rotation and horizontal drift; Oscillate sends a sine wave through vertical position, scale and hue. Open the children of each modulator to set the motion amplitudes. Time uses scene.time; change it to remap the local clock.",
    "animation": {
      "duration": 12,
      "loop": true,
      "autoplay": true,
      "fps": 30,
      "tracks": []
    },
    "objects": [
      {
        "kind": "shape",
        "id": "motion-cross",
        "name": "Cross",
        "shape": "cross",
        "params": {
          "size": 20,
          "width": 5,
          "fill": true,
          "fillColor": "#D2502F",
          "stroke": false
        },
        "stack": [
          {
            "id": "motion-grid",
            "type": "clone",
            "params": {
              "mode": "grid",
              "columns": 15,
              "rows": 9,
              "spacing": [
                2.7,
                2.7
              ]
            }
          },
          {
            "id": "motion-wiggle",
            "type": "wiggle",
            "params": {
              "time": {
                "$expr": "scene.time",
                "fallback": 0
              },
              "frequency": 1.3,
              "seed": 7
            },
            "children": [
              {
                "id": "motion-drift",
                "type": "transform",
                "params": {
                  "x": 6,
                  "rotation": 25
                }
              }
            ]
          },
          {
            "id": "motion-oscillate",
            "type": "oscillate",
            "params": {
              "time": {
                "$expr": "scene.time",
                "fallback": 0
              },
              "frequency": 0.5,
              "elementPhase": 16
            },
            "children": [
              {
                "id": "motion-wave",
                "type": "transform",
                "params": {
                  "y": 18,
                  "scale": 1.18
                }
              },
              {
                "id": "motion-color",
                "type": "color",
                "params": {
                  "mode": "shift",
                  "hue": 22
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
